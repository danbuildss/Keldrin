{
 "openapi": "3.1.0",
 "info": {
  "title": "Keldrin API",
  "version": "0.4.0",
  "description": "Verified corporate-action records for Coinbase tokenized stocks (B20) on Base. Read-only, informational; not an oracle or investment advice. Only independently CONFIRMED records are served. WAD values are exact integer strings scaled by 1e18. Read-only. Rate limited per client; successful reads are cached up to 60 s at the CDN."
 },
 "servers": [
  {
   "url": "https://{host}",
   "variables": {
    "host": {
     "default": "keldrin.vercel.app",
     "description": "deployment host (set at deploy time)"
    }
   }
  },
  {
   "url": "http://127.0.0.1:8787",
   "description": "local"
  }
 ],
 "paths": {
  "/health": {
   "get": {
    "operationId": "getHealth",
    "summary": "Coverage, last run and limitations",
    "responses": {
     "200": {
      "description": "Health",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "data",
          "meta"
         ],
         "properties": {
          "data": {
           "type": "object"
          },
          "meta": {
           "$ref": "#/components/schemas/Meta"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/v1/assets": {
   "get": {
    "operationId": "listAssets",
    "summary": "Tracked tokens with identity state and current multiplier",
    "responses": {
     "200": {
      "description": "Assets",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "data",
          "meta"
         ],
         "properties": {
          "data": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/Asset"
           }
          },
          "meta": {
           "$ref": "#/components/schemas/Meta"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/v1/assets/{contract}": {
   "get": {
    "operationId": "getAsset",
    "parameters": [
     {
      "name": "contract",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^0x[0-9a-fA-F]{40}$"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Asset with identity checks",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "data",
          "meta"
         ],
         "properties": {
          "data": {
           "$ref": "#/components/schemas/Asset"
          },
          "meta": {
           "$ref": "#/components/schemas/Meta"
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "Bad address",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "404": {
      "description": "Unknown asset",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/v1/actions": {
   "get": {
    "operationId": "listActions",
    "summary": "Confirmed corporate actions, newest first",
    "parameters": [
     {
      "name": "contract",
      "in": "query",
      "schema": {
       "type": "string",
       "pattern": "^0x[0-9a-fA-F]{40}$"
      }
     },
     {
      "name": "symbol",
      "in": "query",
      "description": "Exact token symbol (e.g. GOOGLc). Prefer contract.",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "schema": {
       "type": "integer",
       "minimum": 1,
       "maximum": 200,
       "default": 50
      }
     },
     {
      "name": "cursor",
      "in": "query",
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Page of issuer_action records",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "data",
          "meta"
         ],
         "properties": {
          "data": {
           "type": "array",
           "items": {
            "$ref": "https://keldrin.invalid/schemas/issuer-action-v0.2.schema.json"
           }
          },
          "meta": {
           "$ref": "#/components/schemas/Meta"
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "Bad input",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "404": {
      "description": "Unknown symbol",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "Ambiguous symbol",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/v1/actions/{record_id}": {
   "get": {
    "operationId": "getAction",
    "parameters": [
     {
      "name": "record_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Record, review, revisions and company context",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "data",
          "meta"
         ],
         "properties": {
          "data": {
           "type": "object",
           "required": [
            "record",
            "review",
            "revisions",
            "company_context"
           ],
           "properties": {
            "record": {
             "$ref": "https://keldrin.invalid/schemas/issuer-action-v0.2.schema.json"
            },
            "review": {
             "type": "object"
            },
            "revisions": {
             "type": "array"
            },
            "company_context": {
             "type": [
              "object",
              "null"
             ],
             "description": "SEC reconciliation (record_type=reconciliation); null when none is confirmed for this revision."
            }
           }
          },
          "meta": {
           "$ref": "#/components/schemas/Meta"
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "Bad record id",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "404": {
      "description": "No confirmed record",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/llms.txt": {
   "get": {
    "operationId": "getLlmsTxt",
    "responses": {
     "200": {
      "description": "Agent index",
      "content": {
       "text/plain": {
        "schema": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  },
  "/openapi.json": {
   "get": {
    "operationId": "getOpenApi",
    "responses": {
     "200": {
      "description": "This document",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/v1/calendar": {
   "get": {
    "operationId": "getCalendar",
    "summary": "Declared dividends and the date each token is expected to adjust (leading calendar)",
    "description": "Entries come from SEC filing text (quote, document URL and sha256) and are independently re-verified. expected_adjustment_date is the payable date: an observed issuer pattern whose measured rate is stated in each entry's basis, not a guarantee.",
    "parameters": [
     {
      "name": "contract",
      "in": "query",
      "schema": {
       "type": "string",
       "pattern": "^0x[0-9a-fA-F]{40}$"
      }
     },
     {
      "name": "state",
      "in": "query",
      "schema": {
       "enum": [
        "upcoming",
        "applied",
        "not_observed"
       ]
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Calendar entries",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "data",
          "meta"
         ],
         "properties": {
          "data": {
           "type": "array",
           "items": {
            "type": "object"
           }
          },
          "meta": {
           "$ref": "#/components/schemas/Meta"
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "Bad input",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/v1/events": {
   "get": {
    "operationId": "listEvents",
    "summary": "Applied and upcoming corporate actions in one list",
    "parameters": [
     {
      "name": "contract",
      "in": "query",
      "schema": {
       "type": "string",
       "pattern": "^0x[0-9a-fA-F]{40}$"
      }
     },
     {
      "name": "status",
      "in": "query",
      "schema": {
       "enum": [
        "predicted",
        "confirmed_onchain",
        "verified_matched",
        "late",
        "unknown"
       ]
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Events",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "data",
          "meta"
         ],
         "properties": {
          "data": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/Event"
           }
          },
          "meta": {
           "$ref": "#/components/schemas/Meta"
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "Bad input",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "429": {
      "description": "Rate limited (see retry-after)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/v1/changes": {
   "get": {
    "operationId": "listChanges",
    "summary": "Events added or whose status changed since a timestamp (poll with meta.as_of)",
    "parameters": [
     {
      "name": "since",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "format": "date-time"
      }
     },
     {
      "name": "contract",
      "in": "query",
      "schema": {
       "type": "string",
       "pattern": "^0x[0-9a-fA-F]{40}$"
      }
     },
     {
      "name": "status",
      "in": "query",
      "schema": {
       "enum": [
        "predicted",
        "confirmed_onchain",
        "verified_matched",
        "late",
        "unknown"
       ]
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Changed events",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "data",
          "meta"
         ],
         "properties": {
          "data": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/Event"
           }
          },
          "meta": {
           "$ref": "#/components/schemas/Meta"
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "Bad input",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "429": {
      "description": "Rate limited (see retry-after)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/v1/assets/{contract}/nav/history": {
   "get": {
    "summary": "Chainlink NAV history for one token (verified feeds only)",
    "description": "Verbatim Chainlink rounds with feed, phase, aggregator and round id per point, so each value can be re-read onchain with getRoundData. Total-return NAV: it already includes dividends and splits. Official rounds only by default: inside the window in which the proxy served that aggregator, from an aggregator whose decimals match the proxy. interval=daily returns the last official round inside each New York trading day's regular session; trading days without one are listed in meta.quality.missing_trading_days and never filled. Served only when the feed's latest independent review is CONFIRMED, and only rounds that review covered. Returns 503 NAV_NOT_ENABLED until enabled by the operator.",
    "parameters": [
     {
      "name": "contract",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^0x[0-9a-fA-F]{40}$"
      }
     },
     {
      "name": "interval",
      "in": "query",
      "schema": {
       "type": "string",
       "enum": [
        "daily",
        "round"
       ],
       "default": "daily"
      }
     },
     {
      "name": "from",
      "in": "query",
      "schema": {
       "type": "string",
       "format": "date"
      },
      "description": "Default: 90 days before `to` (daily) or 2026-01-01 (round)"
     },
     {
      "name": "to",
      "in": "query",
      "schema": {
       "type": "string",
       "format": "date"
      },
      "description": "Default: today (UTC)"
     },
     {
      "name": "limit",
      "in": "query",
      "schema": {
       "type": "integer",
       "minimum": 1,
       "maximum": 1000,
       "default": 500
      },
      "description": "round interval only"
     },
     {
      "name": "include",
      "in": "query",
      "schema": {
       "type": "string",
       "enum": [
        "official",
        "all"
       ],
       "default": "official"
      },
      "description": "all (interval=round only) also returns non-official rounds with official/proxy_live/decimals_ok flags"
     },
     {
      "name": "cursor",
      "in": "query",
      "schema": {
       "type": "string",
       "pattern": "^\\d{1,12}-\\d{1,30}$"
      },
      "description": "round interval only; pass meta.next_cursor back unchanged (order: updated_at, then round_id)"
     }
    ],
    "responses": {
     "200": {
      "description": "NAV points",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "data",
          "meta"
         ],
         "properties": {
          "data": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/NavPoint"
           }
          },
          "meta": {
           "type": "object",
           "properties": {
            "token": {
             "type": "string"
            },
            "symbol": {
             "type": "string"
            },
            "feed": {
             "type": "string"
            },
            "decimals": {
             "type": "integer"
            },
            "interval": {
             "type": "string"
            },
            "semantics": {
             "type": "string"
            },
            "next_cursor": {
             "type": [
              "string",
              "null"
             ]
            },
            "quality": {
             "type": "object",
             "properties": {
              "rounds_indexed": {
               "type": "integer"
              },
              "first_round_at": {
               "type": [
                "string",
                "null"
               ]
              },
              "last_round_at": {
               "type": [
                "string",
                "null"
               ]
              },
              "missing_trading_days": {
               "type": "array",
               "items": {
                "type": "string"
               }
              },
              "not_covered_days": {
               "type": "array",
               "items": {
                "type": "string"
               }
              },
              "verification": {
               "type": "object"
              }
             }
            }
           }
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "Bad input",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "404": {
      "description": "Unknown token (UNKNOWN_ASSET) or no NAV feed (NO_NAV_FEED)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "503": {
      "description": "Not enabled (NAV_NOT_ENABLED) or feed not independently verified (NAV_NOT_VERIFIED)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "Error": {
    "type": "object",
    "required": [
     "error"
    ],
    "properties": {
     "error": {
      "type": "object",
      "required": [
       "code",
       "message"
      ],
      "properties": {
       "code": {
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "hint": {
        "type": "string"
       }
      }
     }
    }
   },
   "Meta": {
    "type": "object",
    "required": [
     "as_of",
     "schema_version",
     "served"
    ],
    "properties": {
     "as_of": {
      "type": "string",
      "format": "date-time"
     },
     "schema_version": {
      "type": "string"
     },
     "served": {
      "const": "independently_confirmed_records_only"
     },
     "count": {
      "type": "integer"
     },
     "next_cursor": {
      "type": [
       "string",
       "null"
      ],
      "description": "Opaque; pass back unchanged as `cursor`."
     }
    }
   },
   "Asset": {
    "type": "object",
    "required": [
     "chain_id",
     "contract_address",
     "symbol",
     "identity_state"
    ],
    "properties": {
     "chain_id": {
      "const": 8453
     },
     "contract_address": {
      "type": "string"
     },
     "symbol": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "isin": {
      "type": [
       "string",
       "null"
      ]
     },
     "identity_state": {
      "enum": [
       "verified",
       "mismatch",
       "incomplete"
      ]
     },
     "multiplier_wad": {
      "type": [
       "string",
       "null"
      ]
     },
     "observed_block": {
      "type": "string"
     }
    }
   },
   "Event": {
    "type": "object",
    "required": [
     "event_id",
     "chain_id",
     "ticker",
     "contract_address",
     "event_type",
     "status",
     "confidence",
     "expected_adjustment_date",
     "updated_at",
     "warnings"
    ],
    "properties": {
     "event_id": {
      "type": "string"
     },
     "chain_id": {
      "const": 8453
     },
     "ticker": {
      "type": "string",
      "description": "B20 token symbol, e.g. NVDAc. Store contract_address, not the ticker."
     },
     "contract_address": {
      "type": "string"
     },
     "event_type": {
      "enum": [
       "dividend",
       "split",
       "reverse_split",
       "other"
      ]
     },
     "status": {
      "enum": [
       "predicted",
       "confirmed_onchain",
       "verified_matched",
       "late",
       "unknown"
      ],
      "description": "predicted: declared/announced, not applied yet. confirmed_onchain: applied, no dated company declaration matched. verified_matched: applied and matches the declared payable date. late: applied (or expected) more than 1 day after the payable date."
     },
     "confidence": {
      "enum": [
       "high",
       "medium",
       "unknown"
      ],
      "description": "high: two independent sources agree (SEC declaration and onchain). medium: one source. Never guessed."
     },
     "expected_adjustment_date": {
      "type": [
       "string",
       "null"
      ],
      "description": "Payable date of the declaration (observed issuer pattern, not a guarantee). null when no dated declaration is evidenced."
     },
     "adjusted_at": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     },
     "multiplier_before_wad": {
      "type": [
       "string",
       "null"
      ]
     },
     "multiplier_after_wad": {
      "type": [
       "string",
       "null"
      ]
     },
     "multiplier_delta": {
      "type": [
       "string",
       "null"
      ],
      "description": "after/before as an exact decimal string"
     },
     "per_share": {
      "type": [
       "string",
       "null"
      ]
     },
     "record_date": {
      "type": [
       "string",
       "null"
      ]
     },
     "payable_date": {
      "type": [
       "string",
       "null"
      ]
     },
     "sec_filing_url": {
      "type": [
       "string",
       "null"
      ]
     },
     "quoted_text": {
      "type": [
       "string",
       "null"
      ]
     },
     "onchain_tx": {
      "type": [
       "string",
       "null"
      ]
     },
     "issuer_corporate_action_uuid": {
      "type": [
       "string",
       "null"
      ]
     },
     "record_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "basis": {
      "type": "string"
     },
     "updated_at": {
      "type": "string",
      "format": "date-time"
     },
     "warnings": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "Anything that does not add up beyond timing, e.g. multiplier_change_unusually_large_for_cash_dividend. Any warning lowers confidence."
     }
    }
   },
   "NavPoint": {
    "type": "object",
    "required": [
     "chain_id",
     "token",
     "feed",
     "round_id",
     "phase_id",
     "answer_raw",
     "decimals",
     "nav",
     "updated_at",
     "retrieved_at"
    ],
    "properties": {
     "session_day": {
      "type": "string",
      "format": "date",
      "description": "daily interval only"
     },
     "session_close": {
      "type": "string",
      "format": "date-time"
     },
     "chain_id": {
      "type": "integer"
     },
     "token": {
      "type": "string"
     },
     "feed": {
      "type": "string"
     },
     "round_id": {
      "type": "string",
