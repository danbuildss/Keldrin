{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/keldrin/event-record-v0.1.schema.json",
  "title": "Keldrin proposed event record",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "schema_version": {
      "const": "0.1"
    },
    "synthetic": {
      "type": "boolean"
    },
    "underlying": {
      "type": "object",
      "properties": {
        "ticker": {
          "type": "string",
          "minLength": 1
        },
        "cik": {
          "type": [
            "string",
            "null"
          ]
        },
        "share_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "isin": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ticker",
        "cik",
        "share_class",
        "isin"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "chain_id": {
          "const": 8453
        },
        "contract_address": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "mapping_source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "chain_id",
        "contract_address",
        "issuer",
        "mapping_source"
      ],
      "additionalProperties": false
    },
    "event_type": {
      "enum": [
        "earnings_release",
        "material_filing",
        "dividend",
        "stock_split",
        "acquisition",
        "issuer_action",
        "other"
      ]
    },
    "status": {
      "enum": [
        "scheduled",
        "announced",
        "effective",
        "cancelled"
      ]
    },
    "announced_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "effective_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "boolean",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "key",
          "value",
          "unit",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "interpretation": {
      "type": [
        "string",
        "null"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "document_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "rights_state": {
            "enum": [
              "unknown",
              "approved",
              "restricted",
              "denied"
            ]
          }
        },
        "required": [
          "id",
          "url",
          "document_id",
          "retrieved_at",
          "locator",
          "rights_state"
        ],
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "draft",
            "confirmed",
            "unsure",
            "rejected"
          ]
        },
        "reviewed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "state",
        "reviewed_at",
        "review_id",
        "limitations"
      ],
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "properties": {
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "enum": [
            "current",
            "stale",
            "unknown",
            "not_applicable"
          ]
        }
      },
      "required": [
        "as_of",
        "state"
      ],
      "additionalProperties": false
    },
    "supersedes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    }
  },
  "required": [
    "event_id",
    "revision",
    "schema_version",
    "synthetic",
    "underlying",
    "asset",
    "event_type",
    "status",
    "announced_at",
    "effective_at",
    "observed_at",
    "facts",
    "interpretation",
    "sources",
    "verification",
    "freshness",
    "supersedes"
  ],
  "additionalProperties": false
}
